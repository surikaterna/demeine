{
  "include": ["src"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "module": "commonjs",
    "lib": ["esnext"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "rootDir": "./src",
    "outDir": "./lib",
    "target": "es5",
    "declaration": true,
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  }
}

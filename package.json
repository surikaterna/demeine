{
  "name": "demeine",
  "version": "1.3.0",
  "description": "DDDD - Distributed Domain Driven Design",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "rimraf lib && tsc",
    "build:watch": "rimraf lib && tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:start": "npm run test:coverage && start coverage/lcov-report/index.html",
    "check": "biome check src",
    "check:write": "biome check --write src",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format:check": "biome format src",
    "format:fix": "biome format --write src",
    "prepare": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/demeine.git"
  },
  "keywords": [
    "dddd",
    "domain",
    "cqrs"
  ],
  "author": "Surikat AB",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bluebird": "^3.5.36",
    "@types/node": "^22.19.18",
    "@types/uuid": "^9.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "rimraf": "^3.0.2",
    "slf-debug": "^0.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "bugs": {
    "url": "https://github.com/surikaterna/demeine/issues"
  },
  "homepage": "https://github.com/surikaterna/demeine",
  "dependencies": {
    "bluebird": "^3.7.2",
    "p-queue": "^6.6.2",
    "slf": "^2.0.2",
    "uuid": "^9.0.0"
  }
}
